        "forced_importance_accuracy": 0.9299999999999999,
        "forced_importance_kl": 23.181575921545928,
        "accuracy": 0.6702127659574468
      },
      {
        "chunk": "The patient has low potassium, so this is a possibility.",
        "chunk_idx": 34,
        "summary": "identify low potassium",
