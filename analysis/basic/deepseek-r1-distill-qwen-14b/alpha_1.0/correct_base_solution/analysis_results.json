      {
        "chunk": "Possible secondary causes of hypertension include:",
        "chunk_idx": 32,
        "summary": "list causes",
        "function_tags": [
          "knowledge_activation"
        ],
        "depends_on": [],
        "counterfactual_importance_accuracy": -0.09189951294539866,
        "counterfactual_importance_kl": 5.593253369466163,
        "different_trajectories_fraction": 0.9651162790697675,
