        "forced_importance_accuracy": -0.01,
        "forced_importance_kl": 2.702507231205171,
        "accuracy": 0.5617977528089888
      },
      {
        "chunk": "That's combination therapy, which is often used when blood pressure is resistant to treatment.",
        "chunk_idx": 31,
        "summary": "describe combination therapy",
        "function_tags": [
          "evidence_evaluation"
        ],
        "depends_on": [
