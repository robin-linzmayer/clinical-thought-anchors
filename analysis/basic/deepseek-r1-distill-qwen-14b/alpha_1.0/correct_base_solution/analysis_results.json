        "forced_importance_kl": 5.485145696029079,
        "accuracy": 0.5813953488372093
      },
      {
        "chunk": "1. Primary aldosteronism: This can cause high blood pressure and hypokalemia.",
        "chunk_idx": 33,
        "summary": "identify high blood pressure",
        "function_tags": [
          "knowledge_activation"
        ],
        "depends_on": [
          "32"
        ],
        "counterfactual_importance_accuracy": -0.2558612440191388,
        "counterfactual_importance_kl": 0.905567308775744,
        "different_trajectories_fraction": 0.9361702127659575,
        "overdeterminedness": 0.03191489361702127,
